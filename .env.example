PORT=5000
NODE_ENV=development

# Local PostgreSQL
DATABASE_URL=

# JWT — generate two strong random secrets (min 32 chars each)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google OAuth
GOOGLE_CLIENT_ID=

# Apple Sign-In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Gmail SMTP Configuration
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM="HunterX <support.hunterx@gmail.com>"

# App URL — used in password reset link (use exp:// scheme for Expo Go deep linking)
# APP_URL=exp://192.168.1.9:8081/--
APP_URL=http://192.168.1.9:8081

# Hunter ID prefix
HUNTER_ID_PREFIX=HUN
