# Server
PORT=4000

# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Data driver: "memory" (in-process seeded arrays) or "supabase" (real Postgres via Supabase)
# Defaults to "memory" if SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are unset, else defaults to "supabase".
DB_DRIVER=memory

# Supabase (only required when DB_DRIVER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS
CORS_ORIGIN=http://localhost:3000
